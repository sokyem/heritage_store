public/media/
public/Ghana_jersey_old.webp
public/s-l1600.webp

# Business operating spreadsheet: Clients, Measurements, Orders, Payments,
# Revenue. Was served publicly from /public — must never be in a web root.
public/*.xlsx
web/src/Ghana_jerseys/
